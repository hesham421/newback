# ============================================
# ERP System — Local Development Environment Variables
# ============================================
# Copy this file to .env and fill in actual values
# NEVER commit .env to version control (.gitignore already excludes it)
# ============================================

# Required: activate dev profile for local development
SPRING_PROFILES_ACTIVE=dev

# Database — local PostgreSQL (docker/docker-compose.yml)
DB_URL=jdbc:postgresql://localhost:5432/erp_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT — dev value only (min 256 bits). Override with a real secret if needed.
JWT_SECRET=dev-only-secret-minimum-256-bits-long-do-not-use-in-prod

# TestSprite MCP server (API integration test generation/execution)
TESTSPRITE_API_KEY=your-api-key

# Gmail SMTP — use an App Password, NOT your Gmail login password
# Setup: Google Account → Security → 2-Step Verification ON → App Passwords
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Frontend base URL — used to build the one-click links mailed by SEC (password reset).
# Dev defaults to http://localhost:4200 if unset; prod REQUIRES it.
FRONTEND_URL=http://localhost:4200
# Route on FRONTEND_URL that hosts the reset screen (the raw token is appended as ?token=...)
# This MUST match a route the frontend actually serves: App.tsx declares
# /password-reset/complete, and that is also the default in
# application.properties. /reset-password was neither, so a copy of this
# file mailed every reset link to a 404.
PASSWORD_RESET_PATH=/password-reset/complete
