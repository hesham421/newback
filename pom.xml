<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.1</version>
        <relativePath/>
    </parent>

    <groupId>com.erp</groupId>
    <artifactId>erp-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>ERP Platform</name>
    <description>Aggregator for the erp-core library (an auto-configured Spring Boot library jar,
    consumed as a Maven dependency) and erp-app-reference (a runnable application that depends on
    it and proves consumption).</description>

    <modules>
        <module>erp-core</module>
        <module>erp-app-reference</module>
    </modules>

    <properties>
        <!-- Step 03: Java 21 (README §4). The enforcer rule below fails the build at `validate`
             under any JDK older than 21, before compilation, so a stale target/ cannot mask it. -->
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Same as the parent's version; used for the configuration-processor annotation path -->
        <spring-boot.version>4.0.1</spring-boot.version>

        <!-- Dependency versions not managed by Spring Boot -->
        <jjwt.version>0.12.6</jjwt.version>
        <bucket4j.version>8.10.1</bucket4j.version>
        <lombok.version>1.18.40</lombok.version>
        <springdoc.version>2.8.0</springdoc.version>
        <archunit.version>1.4.2</archunit.version>
        <!-- Test-only embedded PostgreSQL fallback (step 02) -->
        <embedded-postgres.version>2.1.0</embedded-postgres.version>
        <embedded-postgres-binaries.version>16.4.0</embedded-postgres-binaries.version>
        <!-- Optional S3 storage provider of erp-core (step 07) -->
        <aws-sdk.version>2.55.11</aws-sdk.version>

        <!-- Default: allow forking on non-Windows environments (see the windows-tests-no-fork
             profile below). -->
        <surefire.forkCount>1</surefire.forkCount>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Modules of this build -->
            <dependency>
                <groupId>com.erp</groupId>
                <artifactId>erp-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- erp-core's test-support classes (TestPostgres + the Testcontainers configuration),
                 published as a test-jar so other modules' tests share the same database selection. -->
            <dependency>
                <groupId>com.erp</groupId>
                <artifactId>erp-core</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
                <scope>test</scope>
            </dependency>

            <!-- JWT -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>

            <!-- Rate limiting -->
            <dependency>
                <groupId>com.bucket4j</groupId>
                <artifactId>bucket4j-core</artifactId>
                <version>${bucket4j.version}</version>
            </dependency>

            <!-- SpringDoc OpenAPI -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- Lombok -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>

            <!-- ArchUnit -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>

            <!-- Testcontainers: the version (2.x) is managed by spring-boot-dependencies (imported
                 by the parent); the modules used by this build are listed here explicitly. -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-postgresql</artifactId>
                <version>${testcontainers.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-junit-jupiter</artifactId>
                <version>${testcontainers.version}</version>
            </dependency>

            <!-- Docker-free test fallback: in-process PostgreSQL 16 (zonky) -->
            <dependency>
                <groupId>io.zonky.test</groupId>
                <artifactId>embedded-postgres</artifactId>
                <version>${embedded-postgres.version}</version>
            </dependency>
            <!-- Pins the zonky embedded PostgreSQL binaries to major 16, matching the
                 Testcontainers image and the README's database default. -->
            <dependency>
                <groupId>io.zonky.test.postgres</groupId>
                <artifactId>embedded-postgres-binaries-bom</artifactId>
                <version>${embedded-postgres-binaries.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Optional S3 storage provider of erp-core (step 07) -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>s3</artifactId>
                <version>${aws-sdk.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.springframework.boot</groupId>
                                <artifactId>spring-boot-configuration-processor</artifactId>
                                <version>${spring-boot.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <!-- JUnit 5 via spring-boot-starter-test; -Dtest= filtering works. reuseForks keeps
                         one JVM for all test classes of a module, so the per-JVM test database
                         (com.erp.testsupport.TestPostgres) is started once and Spring's context cache
                         is shared. On Windows the profile below runs in-process (forkCount=0). -->
                    <configuration>
                        <forkCount>${surefire.forkCount}</forkCount>
                        <reuseForks>true</reuseForks>
                        <argLine>-XX:+EnableDynamicAgentLoading --add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.lang.reflect=ALL-UNNAMED</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Fails the build immediately, with an explicit message, under a JDK older than 21.
                 Runs in `validate`, before compilation. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>enforce-java-21</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                    <message>
                                        This project requires JDK 21 or newer (maven.compiler.release=21).
                                        You are running ${java.runtime.version} from ${java.home}.
                                        Point JAVA_HOME at a JDK 21+ install and retry.
                                    </message>
                                </requireJavaVersion>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>windows-tests-no-fork</id>
            <activation>
                <os>
                    <family>Windows</family>
                </os>
            </activation>
            <properties>
                <!-- Avoid intermittent Surefire fork/classpath issues on Windows -->
                <surefire.forkCount>0</surefire.forkCount>
            </properties>
        </profile>
    </profiles>

</project>
