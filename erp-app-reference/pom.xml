<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.erp</groupId>
        <artifactId>erp-platform</artifactId>
        <version>1.3.0</version>
    </parent>

    <artifactId>erp-app-reference</artifactId>
    <packaging>jar</packaging>

    <name>ERP Reference Application</name>
    <description>Runnable Spring Boot application that consumes erp-core as an ordinary dependency
    (auto-configuration only, no scanning of com.erp.*), adds its own V1000+ migration, and proves
    the library starts with no Redis and no SMTP.</description>

    <properties>
        <!-- Always fork this module's tests, also on Windows (overrides the root
             windows-tests-no-fork profile): with forkCount=0 every module's tests share the Maven
             JVM, and a second embedded Tomcat in it fails with "factory already defined"
             (Tomcat's JVM-wide URL stream handler factory is already registered by erp-core's
             tests from another class loader). -->
        <surefire.forkCount>1</surefire.forkCount>

        <!-- erp-core step 12: the erp-core version this application builds against. In the reactor it
             is the project version (the module next door); CI's consume-published job passes
             -Derp.core.version=<tag version> to build against the artifact published to GitHub
             Packages instead, which proves the jar works outside the reactor. -->
        <erp.core.version>${project.version}</erp.core.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.erp</groupId>
            <artifactId>erp-core</artifactId>
            <version>${erp.core.version}</version>
        </dependency>
        <!-- /actuator/health (Docker healthcheck) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- erp-core declares the driver optional: the application supplies it -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- erp-core declares springdoc optional: the application opts in. Enables Swagger UI and
             erp-core's per-module OpenAPI groups (ErpCoreOpenApiAutoConfiguration). -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- erp-core's test-support (TestPostgres, TestcontainersPostgresConfiguration) and what it needs -->
        <dependency>
            <groupId>com.erp</groupId>
            <artifactId>erp-core</artifactId>
            <version>${erp.core.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.erp.app.ReferenceApplication</mainClass>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
